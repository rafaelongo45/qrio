# PostgreSQL
POSTGRES_DB=qrio
POSTGRES_USER=qrio
POSTGRES_PASSWORD=troque_esta_senha

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=gere_um_segredo_aleatorio_de_64_bytes
JWT_REFRESH_SECRET=gere_outro_segredo_aleatorio_de_64_bytes

# URL pública do frontend (sem barra no final)
# Local: http://localhost:5173
# Produção: https://seudominio.com.br
FRONTEND_URL=http://localhost:5173

# Pix — dados do recebedor
PIX_KEY=qrio@qrio.app
PIX_NAME=qrio
PIX_CITY=rio

# Segredo para rotas administrativas (confirmar pagamento manualmente)
ADMIN_SECRET=$secret